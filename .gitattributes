experiments/scripts_run_phase71_osmroad_production.sh text eol=lf
experiments/rbpf_fgo/*.sh text eol=lf

# Data artifacts are SHA-256 locked byte-for-byte by tests and audit scripts.
# Never convert their line endings (core.autocrlf on Windows would break the
# hashes); this is a no-op on LF checkouts.
*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.pos -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Exact reconstruction patches retain context whitespace and original line endings.
benchmarks/probes/*.patch -text -whitespace

# Frozen performance artifacts retain the exact measured bytes.
benchmarks/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
benchmarks/probes/** -text -whitespace
