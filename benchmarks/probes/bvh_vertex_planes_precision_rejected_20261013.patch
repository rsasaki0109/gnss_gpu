+// Copy immutable vertices into traversal-ordered coordinate planes. No
+// arithmetic is applied to these FP64 values; each lane reads one ordinal.
+__global__ void reflection_vertex_planes_kernel(const Triangle* tris,
+    const int* order, double* planes, int count) {
+  int ordinal = blockIdx.x * blockDim.x + threadIdx.x;
+  if (ordinal >= count) return;
+  const Triangle& tri = tris[order[ordinal]];
+  for (int d = 0; d < 3; ++d) {
+    planes[(size_t)d * count + ordinal] = tri.v0[d];
+    planes[(size_t)(3 + d) * count + ordinal] = tri.v1[d];
+    planes[(size_t)(6 + d) * count + ordinal] = tri.v2[d];
+  }
+}
