 static const int MULTIPATH_BLOCK_SIZE = 128;
 
+// Spread the independent candidates across the existing 256-block target.
+// A separate 32-tile cap left large meshes under-parallelized for <8 rays.
+// The total partial count remains <=256 for <=256 rays, then one per ray.
+static int multipath_tiles(int n_tri, int n_rays) {
+  return std::min((n_tri - 1) / MULTIPATH_BLOCK_SIZE + 1,
+                  std::max(1, 256 / n_rays));
+}
