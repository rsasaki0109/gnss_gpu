+// Same intersection arithmetic with GPU-prepared FP64 triangle edges.
+__device__ static bool mt_intersect_edges(const double origin[3], const double dir[3],
+                                    const double v0[3], const double e1[3],
+                                    const double e2[3], double& t) {
+  const double EPSILON = 1e-12;
+  double h[3] = {dir[1] * e2[2] - dir[2] * e2[1],
+                  dir[2] * e2[0] - dir[0] * e2[2],
+                  dir[0] * e2[1] - dir[1] * e2[0]};
+  double a = e1[0] * h[0] + e1[1] * h[1] + e1[2] * h[2];
+  if (fabs(a) < EPSILON) return false;
+  double f = 1.0 / a;
+  double s[3] = {origin[0] - v0[0], origin[1] - v0[1], origin[2] - v0[2]};
+  double u = f * (s[0] * h[0] + s[1] * h[1] + s[2] * h[2]);
+  if (u < 0.0 || u > 1.0) return false;
+  double q[3] = {s[1] * e1[2] - s[2] * e1[1],
+                  s[2] * e1[0] - s[0] * e1[2],
+                  s[0] * e1[1] - s[1] * e1[0]};
+  double v = f * (dir[0] * q[0] + dir[1] * q[1] + dir[2] * q[2]);
+  if (v < 0.0 || u + v > 1.0) return false;
+  t = f * (e2[0] * q[0] + e2[1] * q[1] + e2[2] * q[2]);
+  return t > EPSILON;
+}
