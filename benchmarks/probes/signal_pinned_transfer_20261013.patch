+// Reusable staging preserves ordinary owning caller output arrays. Grow only
+// after completed copies, and release the previous buffer before allocating so
+// locked host memory never exceeds the32MiB requested-capacity limit.
+struct PinnedOutputBuffer {
+    float* data = nullptr;
+    size_t capacity = 0;
+
+    ~PinnedOutputBuffer() { reset(); }
+    void reset() noexcept {
+        if (data) cudaFreeHost(data);
+        data = nullptr;
+        capacity = 0;
+    }
+    bool try_reserve(size_t count) {
+        if (count <= capacity) return true;
+        reset();
+        float* replacement = nullptr;
+        cudaError_t status = cudaMallocHost(&replacement, count * sizeof(float));
+        if (status == cudaErrorMemoryAllocation) {
+            // The preceding synchronization succeeded. Clear only this new
+            // optional allocation failure and retain the original copy path.
+            cudaGetLastError();
+            return false;
+        }
+        CUDA_CHECK(status);
+        data = replacement;
+        capacity = count;
+        return true;
+    }
+};
