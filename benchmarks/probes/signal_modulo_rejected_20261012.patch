+// Valid channels use these four fixed lengths. Constant signed remainders
+// avoid a runtime integer division without changing negative-chip semantics.
+__device__ __forceinline__ int code_remainder(int chip, int code_length) {
+    switch (code_length) {
+    case kGpsCodeLen: return chip % kGpsCodeLen;
+    case kGloCodeLen: return chip % kGloCodeLen;
+    case kGalCodeLen: return chip % kGalCodeLen;
+    case kBdsCodeLen: return chip % kBdsCodeLen;
+    default: return chip % code_length;
+    }
+}
