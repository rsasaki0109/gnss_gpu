+void validate_channel_finite(double value, size_t index, const char* field) {
+  if (!std::isfinite(value)) {
+    const std::string name = "channels[" + std::to_string(index) + "]." + field;
+    pv::validate_finite(value, name.c_str());
+  }
+}
+
+void validate_channel_positive_finite(double value, size_t index, const char* field) {
+  if (!std::isfinite(value) || value <= 0.0) {
+    const std::string name = "channels[" + std::to_string(index) + "]." + field;
+    pv::validate_positive_finite(value, name.c_str());
+  }
