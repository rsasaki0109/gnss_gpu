+// Only storage ownership changes: retain Thrust's inclusive-scan dispatch,
+// its FP64 addition order, stream and optional synchronization. The usual scan
+// needs one allocation; concurrent temporary requests use independent storage.
+class PFDScanAllocator {
+public:
+    using value_type = char;
+    PFDeviceState* state;
+
+    char* allocate(std::ptrdiff_t bytes) {
+        if (bytes <= 0) return nullptr;
+        std::size_t required = static_cast<std::size_t>(bytes);
+        if (state->scan_scratch_in_use) {
+            char* separate = nullptr;
+            CUDA_CHECK(cudaMalloc(&separate, required));
+            return separate;
+        }
+        if (required > state->scan_scratch_capacity) {
+            CUDA_CHECK(cudaFree(state->d_scan_scratch));
+            state->d_scan_scratch = nullptr;
+            state->scan_scratch_capacity = 0;
+            CUDA_CHECK(cudaMalloc(&state->d_scan_scratch, required));
+            state->scan_scratch_capacity = required;
+        }
+        state->scan_scratch_in_use = true;
+        return state->d_scan_scratch;
+    }
+
+    void deallocate(char* pointer, std::size_t) {
+        if (pointer == state->d_scan_scratch) {
+            state->scan_scratch_in_use = false;
+        } else {
+            CUDA_CHECK(cudaFree(pointer));
+        }
+    }
+};
