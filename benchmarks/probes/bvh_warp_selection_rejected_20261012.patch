 static const int MULTIPATH_BLOCK_SIZE = 128;
+static_assert(MULTIPATH_BLOCK_SIZE % 32 == 0, "Reflection reduction needs full warps");
+
+// Compare only the selection key. Every valid ordinal belongs to exactly one
+// thread, so its original point/delay payload can be written by that winner.
+// No floating-point sum or approximation is introduced by changing the tree.
+__device__ static int warp_multipath_order(const MultipathCandidate& candidate) {
+  double delay = candidate.delay;
+  int order = candidate.order;
+  int lane = threadIdx.x % 32;
+  for (int offset = 16; offset > 0; offset /= 2) {
+    double other_delay = __shfl_down_sync(0xffffffffu, delay, offset);
+    int other_order = __shfl_down_sync(0xffffffffu, order, offset);
+    if (lane < offset && other_order >= 0 &&
+        (order < 0 || other_delay < delay ||
+         (other_delay == delay && other_order < order))) {
+      delay = other_delay;
+      order = other_order;
+    }
+  }
+  return __shfl_sync(0xffffffffu, order, 0);
+}
