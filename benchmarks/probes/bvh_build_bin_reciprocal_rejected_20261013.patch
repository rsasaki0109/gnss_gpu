+// Only the integer bucket is consumed. A product safely inside a bucket
+// gives the same clamped integer as the original division. The2^-40 guard
+// is wider than the conservative2^-46 absolute error bound for0<scaled<12,
+// including a subnormal rounded reciprocal. Near boundaries and nonfinite
+// values keep the original division/conversion/clamping.
+static int build_bin_index(double centroid, double axis_min, double width,
+                           double inverse_width) {
+  double numerator = centroid - axis_min;
+  double scaled = numerator * inverse_width;
+  if (scaled > 0.0 && scaled < SAH_BINS) {
+    int candidate = (int)scaled;
+    if (scaled - candidate > 0x1p-40 && candidate + 1.0 - scaled > 0x1p-40)
+      return candidate;
+  }
+  int b = (int)(numerator / width);
+  if (b < 0) b = 0;
+  if (b >= SAH_BINS) b = SAH_BINS - 1;
+  return b;
+}
