;; Strict f64 candidate filtering. Expressions follow MeshBVH.reflectionsBatchJS.
;; Emit triangle/source IDs and full-precision points in original traversal order.
(module
  (import "env" "memory" (memory 1))
  (func (export "scan") (param $edges i32) (param $planes i32) (param $projection i32) (param $triangles i32) (param $sources i32) (param $sourceCount i32) (param $rx f64) (param $ry f64) (param $rz f64) (param $output i32) (param $capacity i32) (result i32)
    (local $t i32)
    (local $s i32)
    (local $count i32)
    (local $pp i32)
    (local $ep i32)
    (local $sp i32)
    (local $out i32)
    (local $axis i32)
    (local $i i32)
    (local $j i32)
    (local $nx f64)
    (local $ny f64)
    (local $nz f64)
    (local $plane f64)
    (local $dr f64)
    (local $mx f64)
    (local $my f64)
    (local $mz f64)
    (local $ai f64)
    (local $aj f64)
    (local $bi f64)
    (local $bj f64)
    (local $ci f64)
    (local $cj f64)
    (local $determinant f64)
    (local $sx f64)
    (local $sy f64)
    (local $sz f64)
    (local $ds f64)
    (local $factor f64)
    (local $qx f64)
    (local $qy f64)
    (local $qz f64)
    (local $x f64)
    (local $y f64)
    (local $numerator f64)
    (local $u f64)
    (local $v f64)
    (block $done
      (loop $triangles
        (br_if $done (i32.ge_u (local.get $t) (local.get $triangles)))
        (block $nextTriangle
          (local.set $pp (i32.add (local.get $planes) (i32.mul (local.get $t) (i32.const 32))))
          (local.set $nx (f64.load offset=0 (local.get $pp)))
          (local.set $ny (f64.load offset=8 (local.get $pp)))
          (local.set $nz (f64.load offset=16 (local.get $pp)))
          (local.set $plane (f64.load offset=24 (local.get $pp)))
          (local.set $dr (f64.sub (f64.add (f64.add (f64.mul (local.get $nx) (local.get $rx)) (f64.mul (local.get $ny) (local.get $ry))) (f64.mul (local.get $nz) (local.get $rz))) (local.get $plane)))
          (br_if $nextTriangle (f64.lt (f64.abs (local.get $dr)) (f64.const 1e-5)))
          (local.set $mx (f64.sub (local.get $rx) (f64.mul (f64.mul (f64.const 2) (local.get $dr)) (local.get $nx))))
          (local.set $my (f64.sub (local.get $ry) (f64.mul (f64.mul (f64.const 2) (local.get $dr)) (local.get $ny))))
          (local.set $mz (f64.sub (local.get $rz) (f64.mul (f64.mul (f64.const 2) (local.get $dr)) (local.get $nz))))
          (local.set $axis (i32.load8_u (i32.add (local.get $projection) (local.get $t))))
          (local.set $i (i32.rem_u (i32.add (local.get $axis) (i32.const 1)) (i32.const 3)))
          (local.set $j (i32.rem_u (i32.add (local.get $axis) (i32.const 2)) (i32.const 3)))
          (local.set $ep (i32.add (local.get $edges) (i32.mul (local.get $t) (i32.const 72))))
          (local.set $ai (f64.load offset=0 (i32.add (local.get $ep) (i32.mul (local.get $i) (i32.const 8)))))
          (local.set $aj (f64.load offset=0 (i32.add (local.get $ep) (i32.mul (local.get $j) (i32.const 8)))))
          (local.set $bi (f64.load offset=24 (i32.add (local.get $ep) (i32.mul (local.get $i) (i32.const 8)))))
          (local.set $bj (f64.load offset=24 (i32.add (local.get $ep) (i32.mul (local.get $j) (i32.const 8)))))
          (local.set $ci (f64.load offset=48 (i32.add (local.get $ep) (i32.mul (local.get $i) (i32.const 8)))))
          (local.set $cj (f64.load offset=48 (i32.add (local.get $ep) (i32.mul (local.get $j) (i32.const 8)))))
          (local.set $determinant (f64.sub (f64.mul (local.get $bi) (local.get $cj)) (f64.mul (local.get $bj) (local.get $ci))))
          (local.set $s (i32.const 0))
          (block $endSources
            (loop $sources
              (br_if $endSources (i32.ge_u (local.get $s) (local.get $sourceCount)))
              (block $nextSource
                (local.set $sp (i32.add (local.get $sources) (i32.mul (local.get $s) (i32.const 24))))
                (local.set $sx (f64.load offset=0 (local.get $sp)))
                (local.set $sy (f64.load offset=8 (local.get $sp)))
                (local.set $sz (f64.load offset=16 (local.get $sp)))
                (local.set $ds (f64.sub (f64.add (f64.add (f64.mul (local.get $nx) (local.get $sx)) (f64.mul (local.get $ny) (local.get $sy))) (f64.mul (local.get $nz) (local.get $sz))) (local.get $plane)))
                (br_if $nextSource (f64.le (f64.mul (local.get $dr) (local.get $ds)) (f64.const 0)))
                (local.set $factor (f64.div (local.get $dr) (f64.add (local.get $dr) (local.get $ds))))
                (local.set $qx (f64.add (local.get $mx) (f64.mul (f64.sub (local.get $sx) (local.get $mx)) (local.get $factor))))
                (local.set $qy (f64.add (local.get $my) (f64.mul (f64.sub (local.get $sy) (local.get $my)) (local.get $factor))))
                (local.set $qz (f64.add (local.get $mz) (f64.mul (f64.sub (local.get $sz) (local.get $mz)) (local.get $factor))))
                (local.set $x (f64.sub (if (result f64) (i32.eq (local.get $i) (i32.const 0)) (then (local.get $qx)) (else (if (result f64) (i32.eq (local.get $i) (i32.const 1)) (then (local.get $qy)) (else (local.get $qz))))) (local.get $ai)))
                (local.set $y (f64.sub (if (result f64) (i32.eq (local.get $j) (i32.const 0)) (then (local.get $qx)) (else (if (result f64) (i32.eq (local.get $j) (i32.const 1)) (then (local.get $qy)) (else (local.get $qz))))) (local.get $aj)))
                (local.set $numerator (f64.sub (f64.mul (local.get $x) (local.get $cj)) (f64.mul (local.get $y) (local.get $ci))))
                (br_if $nextSource (f64.gt (f64.abs (local.get $numerator)) (f64.mul (f64.const 2) (f64.abs (local.get $determinant)))))
                (local.set $u (f64.div (local.get $numerator) (local.get $determinant)))
                (local.set $v (f64.div (f64.sub (f64.mul (local.get $bi) (local.get $y)) (f64.mul (local.get $bj) (local.get $x))) (local.get $determinant)))
                (br_if $nextSource (i32.eqz (i32.and (i32.and (f64.ge (local.get $u) (f64.const -1e-10)) (f64.ge (local.get $v) (f64.const -1e-10))) (f64.le (f64.add (local.get $u) (local.get $v)) (f64.const 1.0000000001)))))
                (if (i32.ge_u (local.get $count) (local.get $capacity)) (then (return (i32.const -1))))
                (local.set $out (i32.add (local.get $output) (i32.mul (local.get $count) (i32.const 32))))
                (i32.store (local.get $out) (local.get $t))
                (i32.store offset=4 (local.get $out) (local.get $s))
                (f64.store offset=8 (local.get $out) (local.get $qx))
                (f64.store offset=16 (local.get $out) (local.get $qy))
                (f64.store offset=24 (local.get $out) (local.get $qz))
                (local.set $count (i32.add (local.get $count) (i32.const 1)))
              )
              (local.set $s (i32.add (local.get $s) (i32.const 1)))
              (br $sources)))
        )
        (local.set $t (i32.add (local.get $t) (i32.const 1)))
        (br $triangles)))
    (local.get $count)
))
