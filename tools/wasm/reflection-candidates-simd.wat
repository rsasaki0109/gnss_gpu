;; Strict f64x2 candidate filtering: two independent sources per vector.
;; Source pairs are packed x0,x1,y0,y1,z0,z1; the odd final lane is never emitted.
;; Every lane follows the scalar kernel operation order and tolerances.
;; Emit triangle/source IDs and full-precision points in original traversal order.
(module
  (import "env" "memory" (memory 1))
  (func (export "scan") (param $edges i32) (param $planes i32) (param $projection i32) (param $triangles i32) (param $sources i32) (param $sourceCount i32) (param $rx f64) (param $ry f64) (param $rz f64) (param $output i32) (param $capacity i32) (result i32)
    (local $t i32)
    (local $s i32)
    (local $count i32)
    (local $pp i32)
    (local $ep i32)
    (local $sp i32)
    (local $out i32)
    (local $axis i32)
    (local $i i32)
    (local $j i32)
    (local $nx f64)
    (local $ny f64)
    (local $nz f64)
    (local $plane f64)
    (local $dr f64)
    (local $mx f64)
    (local $my f64)
    (local $mz f64)
    (local $ai f64)
    (local $aj f64)
    (local $bi f64)
    (local $bj f64)
    (local $ci f64)
    (local $cj f64)
    (local $determinant f64)
    (local $bits i32)
    (local $nxv v128)
    (local $nyv v128)
    (local $nzv v128)
    (local $planev v128)
    (local $drv v128)
    (local $mxv v128)
    (local $myv v128)
    (local $mzv v128)
    (local $aiv v128)
    (local $ajv v128)
    (local $biv v128)
    (local $bjv v128)
    (local $civ v128)
    (local $cjv v128)
    (local $determinantv v128)
    (local $sxv v128)
    (local $syv v128)
    (local $szv v128)
    (local $dsv v128)
    (local $factorv v128)
    (local $qxv v128)
    (local $qyv v128)
    (local $qzv v128)
    (local $xv v128)
    (local $yv v128)
    (local $numeratorv v128)
    (local $uv v128)
    (local $vv v128)
    (local $maskv v128)
    (block $done
      (loop $triangles
        (br_if $done (i32.ge_u (local.get $t) (local.get $triangles)))
        (block $nextTriangle
          (local.set $pp (i32.add (local.get $planes) (i32.mul (local.get $t) (i32.const 32))))
          (local.set $nx (f64.load offset=0 (local.get $pp)))
          (local.set $ny (f64.load offset=8 (local.get $pp)))
          (local.set $nz (f64.load offset=16 (local.get $pp)))
          (local.set $plane (f64.load offset=24 (local.get $pp)))
          (local.set $dr (f64.sub (f64.add (f64.add (f64.mul (local.get $nx) (local.get $rx)) (f64.mul (local.get $ny) (local.get $ry))) (f64.mul (local.get $nz) (local.get $rz))) (local.get $plane)))
          (br_if $nextTriangle (f64.lt (f64.abs (local.get $dr)) (f64.const 1e-5)))
          (local.set $mx (f64.sub (local.get $rx) (f64.mul (f64.mul (f64.const 2) (local.get $dr)) (local.get $nx))))
          (local.set $my (f64.sub (local.get $ry) (f64.mul (f64.mul (f64.const 2) (local.get $dr)) (local.get $ny))))
          (local.set $mz (f64.sub (local.get $rz) (f64.mul (f64.mul (f64.const 2) (local.get $dr)) (local.get $nz))))
          (local.set $axis (i32.load8_u (i32.add (local.get $projection) (local.get $t))))
          (local.set $i (i32.rem_u (i32.add (local.get $axis) (i32.const 1)) (i32.const 3)))
          (local.set $j (i32.rem_u (i32.add (local.get $axis) (i32.const 2)) (i32.const 3)))
          (local.set $ep (i32.add (local.get $edges) (i32.mul (local.get $t) (i32.const 72))))
          (local.set $ai (f64.load offset=0 (i32.add (local.get $ep) (i32.mul (local.get $i) (i32.const 8)))))
          (local.set $aj (f64.load offset=0 (i32.add (local.get $ep) (i32.mul (local.get $j) (i32.const 8)))))
          (local.set $bi (f64.load offset=24 (i32.add (local.get $ep) (i32.mul (local.get $i) (i32.const 8)))))
          (local.set $bj (f64.load offset=24 (i32.add (local.get $ep) (i32.mul (local.get $j) (i32.const 8)))))
          (local.set $ci (f64.load offset=48 (i32.add (local.get $ep) (i32.mul (local.get $i) (i32.const 8)))))
          (local.set $cj (f64.load offset=48 (i32.add (local.get $ep) (i32.mul (local.get $j) (i32.const 8)))))
          (local.set $determinant (f64.sub (f64.mul (local.get $bi) (local.get $cj)) (f64.mul (local.get $bj) (local.get $ci))))
          (local.set $nxv (f64x2.splat (local.get $nx)))
          (local.set $nyv (f64x2.splat (local.get $ny)))
          (local.set $nzv (f64x2.splat (local.get $nz)))
          (local.set $planev (f64x2.splat (local.get $plane)))
          (local.set $drv (f64x2.splat (local.get $dr)))
          (local.set $mxv (f64x2.splat (local.get $mx)))
          (local.set $myv (f64x2.splat (local.get $my)))
          (local.set $mzv (f64x2.splat (local.get $mz)))
          (local.set $aiv (f64x2.splat (local.get $ai)))
          (local.set $ajv (f64x2.splat (local.get $aj)))
          (local.set $biv (f64x2.splat (local.get $bi)))
          (local.set $bjv (f64x2.splat (local.get $bj)))
          (local.set $civ (f64x2.splat (local.get $ci)))
          (local.set $cjv (f64x2.splat (local.get $cj)))
          (local.set $determinantv (f64x2.splat (local.get $determinant)))
          (local.set $s (i32.const 0))
          (block $endSources
            (loop $sources
              (br_if $endSources (i32.ge_u (local.get $s) (local.get $sourceCount)))
              (block $nextSource
                (local.set $sp (i32.add (local.get $sources) (i32.mul (local.get $s) (i32.const 24))))
                (local.set $sxv (v128.load offset=0 (local.get $sp)))
                (local.set $syv (v128.load offset=16 (local.get $sp)))
                (local.set $szv (v128.load offset=32 (local.get $sp)))
                (local.set $dsv (f64x2.sub (f64x2.add (f64x2.add (f64x2.mul (local.get $nxv) (local.get $sxv)) (f64x2.mul (local.get $nyv) (local.get $syv))) (f64x2.mul (local.get $nzv) (local.get $szv))) (local.get $planev)))
                (local.set $maskv (v128.not (f64x2.le (f64x2.mul (local.get $drv) (local.get $dsv)) (v128.const f64x2 0 0))))
                (br_if $nextSource (i32.eqz (v128.any_true (local.get $maskv))))
                (local.set $factorv (f64x2.div (local.get $drv) (f64x2.add (local.get $drv) (local.get $dsv))))
                (local.set $qxv (f64x2.add (local.get $mxv) (f64x2.mul (f64x2.sub (local.get $sxv) (local.get $mxv)) (local.get $factorv))))
                (local.set $qyv (f64x2.add (local.get $myv) (f64x2.mul (f64x2.sub (local.get $syv) (local.get $myv)) (local.get $factorv))))
                (local.set $qzv (f64x2.add (local.get $mzv) (f64x2.mul (f64x2.sub (local.get $szv) (local.get $mzv)) (local.get $factorv))))
                (local.set $xv (f64x2.sub (if (result v128) (i32.eq (local.get $i) (i32.const 0)) (then (local.get $qxv)) (else (if (result v128) (i32.eq (local.get $i) (i32.const 1)) (then (local.get $qyv)) (else (local.get $qzv))))) (local.get $aiv)))
                (local.set $yv (f64x2.sub (if (result v128) (i32.eq (local.get $j) (i32.const 0)) (then (local.get $qxv)) (else (if (result v128) (i32.eq (local.get $j) (i32.const 1)) (then (local.get $qyv)) (else (local.get $qzv))))) (local.get $ajv)))
                (local.set $numeratorv (f64x2.sub (f64x2.mul (local.get $xv) (local.get $cjv)) (f64x2.mul (local.get $yv) (local.get $civ))))
                (local.set $maskv (v128.and (local.get $maskv) (v128.not (f64x2.gt (f64x2.abs (local.get $numeratorv)) (f64x2.mul (v128.const f64x2 2 2) (f64x2.abs (local.get $determinantv)))))))
                (br_if $nextSource (i32.eqz (v128.any_true (local.get $maskv))))
                (local.set $uv (f64x2.div (local.get $numeratorv) (local.get $determinantv)))
                (local.set $vv (f64x2.div (f64x2.sub (f64x2.mul (local.get $biv) (local.get $yv)) (f64x2.mul (local.get $bjv) (local.get $xv))) (local.get $determinantv)))
                (local.set $maskv (v128.and (local.get $maskv) (v128.and (v128.and (f64x2.ge (local.get $uv) (v128.const f64x2 -1e-10 -1e-10)) (f64x2.ge (local.get $vv) (v128.const f64x2 -1e-10 -1e-10))) (f64x2.le (f64x2.add (local.get $uv) (local.get $vv)) (v128.const f64x2 1.0000000001 1.0000000001)))))
                (local.set $bits (i64x2.bitmask (local.get $maskv)))
                (if (i32.and (local.get $bits) (i32.const 1)) (then
                  (if (i32.ge_u (local.get $count) (local.get $capacity)) (then (return (i32.const -1))))
                  (local.set $out (i32.add (local.get $output) (i32.mul (local.get $count) (i32.const 32))))
                  (i32.store (local.get $out) (local.get $t))
                  (i32.store offset=4 (local.get $out) (i32.add (local.get $s) (i32.const 0)))
                  (f64.store offset=8 (local.get $out) (f64x2.extract_lane 0 (local.get $qxv)))
                  (f64.store offset=16 (local.get $out) (f64x2.extract_lane 0 (local.get $qyv)))
                  (f64.store offset=24 (local.get $out) (f64x2.extract_lane 0 (local.get $qzv)))
                  (local.set $count (i32.add (local.get $count) (i32.const 1)))
                ))
                (if (i32.and (i32.ne (i32.and (local.get $bits) (i32.const 2)) (i32.const 0)) (i32.lt_u (i32.add (local.get $s) (i32.const 1)) (local.get $sourceCount))) (then
                  (if (i32.ge_u (local.get $count) (local.get $capacity)) (then (return (i32.const -1))))
                  (local.set $out (i32.add (local.get $output) (i32.mul (local.get $count) (i32.const 32))))
                  (i32.store (local.get $out) (local.get $t))
                  (i32.store offset=4 (local.get $out) (i32.add (local.get $s) (i32.const 1)))
                  (f64.store offset=8 (local.get $out) (f64x2.extract_lane 1 (local.get $qxv)))
                  (f64.store offset=16 (local.get $out) (f64x2.extract_lane 1 (local.get $qyv)))
                  (f64.store offset=24 (local.get $out) (f64x2.extract_lane 1 (local.get $qzv)))
                  (local.set $count (i32.add (local.get $count) (i32.const 1)))
                ))
              )
              (local.set $s (i32.add (local.get $s) (i32.const 2)))
              (br $sources)))
        )
        (local.set $t (i32.add (local.get $t) (i32.const 1)))
        (br $triangles)))
    (local.get $count)
))
